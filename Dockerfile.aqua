# Build Aqua separately so the runtime image contains only the CLI and certificates.
FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS build
ARG AQUA_VERSION=v2.48.3
RUN CGO_ENABLED=0 go install github.com/aquaproj/aqua/v2/cmd/aqua@${AQUA_VERSION}

FROM alpine:3.22
COPY --from=build /go/bin/aqua /usr/local/bin/aqua
RUN apk add --no-cache ca-certificates
ENV AQUA_ROOT_DIR=/aqua
ENV PATH=/aqua/bin:$PATH
ENTRYPOINT ["/usr/local/bin/aqua"]
